# このファイルを .env にコピーして編集してください（.env は git に含めない）。
# APIキーが無くても、文書取り込み・CSV整理・ローカルDB保存は動きます。

# --- OpenAI（任意） ---
# 設定すると OpenAI embedding と日本語回答生成を使います。
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- パス（任意・既定値あり） ---
RAG_DATA_DIR=data
RAG_PERSIST_DIR=chroma_db
RAG_COLLECTION=battery_research

# --- チャンク分割（任意） ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# --- 検索（任意） ---
RAG_TOP_K=6
